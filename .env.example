DOMAIN=localhost
ACME_EMAIL=you@example.com

# SQL Server SA password: at least 8 chars, upper, lower, number, symbol
MSSQL_SA_PASSWORD=ChangeThis_Str0ngP@ss!

# Backend connection string used inside Docker network
CONNECTION_STRING=Server=db,1433;Database=Clinic;User Id=sa;Password=ChangeThis_Str0ngP@ss!;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True

# Comma-separated browser origins allowed to call the API directly
CORS_ALLOWED_ORIGINS=http://localhost,https://localhost

# Leave empty in production so the browser calls /api on the same domain
VITE_API_BASE_URL=

APPLY_MIGRATIONS=true
SEED_DATABASE=false

# JWT — use a long random value (32+ characters)
Jwt__Key=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=Medora
Jwt__Audience=MedoraClients
Jwt__DurationInMinutes=60

# Optional Redis (compose already starts redis)
Redis__Connection=redis:6379

# Cloudinary
CloudinarySettings__CloudName=
CloudinarySettings__ApiKey=
CloudinarySettings__ApiSecret=

# Email
Email__SmtpHost=
Email__SmtpPort=587
Email__User=
Email__Password=
Email__From=

# Firebase: paste the full service-account JSON as one line, or mount a file
FIREBASE_CREDENTIALS_JSON=
Firebase__CredentialsPath=

# Google OAuth (backend)
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Groq chatbot key must NOT be shipped in the public frontend bundle for a commercial product.
# Keep it server-side later. Placeholder only:
VITE_GROQ_API_KEY=
